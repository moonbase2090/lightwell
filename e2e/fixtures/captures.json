   "path": "Cargo.toml",
   "content": "[workspace]\nmembers = [\"crates/lightwell-app\", \"crates/lightwell-core\", \"crates/lightwell-cli\"]\nresolver = \"2\"\n\n[workspace.package]\nversion = \"0.1.15\"\nedition = \"2021\"\nlicense = \"MIT\"\nrepository = \"https://github.com/moonbase2090/lightwell\"\nrust-version = \"1.90\"\n\n[workspace.dependencies]\nfs2 = \"0.4\"\nglob = \"0.3\"\nnotify-debouncer-mini = \"0.7\"\nproc-macro2 = { version = \"1\", features = [\"span-locations\"] }\nquote = \"1\"\nsha2 = \"0.10\"\nserde = { version = \"1\", features = [\"derive\"] }\nserde_json = \"1\"\nshell-words = \"1.1\"\nsyn = { version = \"2\", features = [\"full\"] }\ntauri = \"2\"\ntauri-build = \"2\"\ntauri-plugin-dialog = \"2\"\ntauri-plugin-process = \"2.4.0\"\ntauri-plugin-updater = \"2.14.0\"\ntoml = \"0.8\"\n\n# crates.io has yanked every zip release except 9.0.3 and 9.0.4.\n# tauri-plugin-updater 2.14 still requires zip 4, so resolve that line from the tag.\n[patch.crates-io]\nzip = { git = \"https://github.com/zip-rs/zip2\", tag = \"v4.6.1\" }\n",
