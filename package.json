{
  "name": "lightwell",
  "version": "0.1.24",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "lightwell": "bin/lightwell.mjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test src/*.test.ts",
    "test:language-packs": "tsx --test src/language-pack-loader.test.ts",
    "generate:language-packs": "tsx scripts/generate-language-pack-catalog.ts",
    "check:language-packs": "node scripts/check-language-pack-parity.mjs",
    "extract": "tsx src/cli.ts extract",
    "lightwell": "tsx src/cli.ts",
    "check:licenses": "node scripts/check-dependency-licenses.mjs",
    "tauri:dev": "tauri dev --config crates/lightwell-app/tauri.conf.json",
    "tauri:build": "tauri build --config crates/lightwell-app/tauri.conf.json",
    "preview": "vite preview --host localhost",
    "test:e2e": "playwright test",
    "check:config-infra-parity": "tsx scripts/check-config-infra-parity.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.51.0",
    "monaco-editor-core": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
