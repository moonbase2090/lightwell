{
  "name": "lightwell",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "lightwell": "bin/lightwell.mjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "extract": "tsx src/cli.ts extract",
    "lightwell": "tsx src/cli.ts",
    "check:licenses": "node scripts/check-dependency-licenses.mjs",
    "tauri:dev": "tauri dev --config crates/lightwell-app/tauri.conf.json",
    "tauri:build": "tauri build --config crates/lightwell-app/tauri.conf.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
