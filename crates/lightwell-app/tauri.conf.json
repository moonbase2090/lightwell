{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightwell",
  "version": "0.1.19",
  "identifier": "com.moonbase2090.lightwell",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../.."
    },
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lightwell",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0A1628"
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "license": "MPL-2.0",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["app", "deb", "appimage", "rpm"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQzUxRjZCMEFENkQzNTAKUldSUTA5WUtheC9GcnhXQ3BJTWgxcHczdENCU0o1SEFsM091UjJhbWpUQkFFcVpjcUMvYXh2RnQK",
      "endpoints": [
        "https://github.com/moonbase2090/lightwell/releases/latest/download/latest.json"
      ]
    }
  }
}
