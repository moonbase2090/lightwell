{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightwell",
  "version": "0.1.1",
  "identifier": "com.moonbase2090.lightwell",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../.."
    },
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lightwell",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "license": "MPL-2.0",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "targets": ["app", "deb"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
