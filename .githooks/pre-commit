#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"

if ! command -v rustfmt >/dev/null 2>&1; then
  echo "pre-commit: rustfmt is not installed (try: rustup component add rustfmt)" >&2
  exit 1
fi

found=0
failed=0
while IFS= read -r file; do
  [ -n "$file" ] || continue
  case "$file" in
    *.rs) ;;
    *) continue ;;
  esac
  found=1
  [ -f "$file" ] || continue
  if ! rustfmt --check "$file"; then
    failed=1
  fi
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR)
EOF

if [ "$found" -eq 0 ]; then
  exit 0
fi

if [ "$failed" -ne 0 ]; then
  echo "pre-commit: rustfmt check failed; fix with: cargo fmt --all" >&2
  exit 1
fi
